# Dependencies can't run preinstall/install/postinstall scripts.
# `npm run <script>` still works.
ignore-scripts=true

# Only install from the registry, never from git repos or tarball URLs.
allow-git=none
allow-remote=none

# Skip versions published in the last 2 days.
# For an urgent fix: npm install <pkg> --min-release-age=0
min-release-age=2

save-exact=true
# Also enforces engines.npm, which guarantees the settings above are supported.
engine-strict=true
