{
  "name": "oblio-mcp",
  "version": "1.0.0",
  "description": "MCP server for Oblio accounting software. Perfect for Claude and other MCP compatible platforms.",
  "homepage": "https://github.com/valentinludu/oblio-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/valentinludu/oblio-mcp.git"
  },
  "bugs": "https://github.com/valentinludu/oblio-mcp/issues",
  "author": "Valentin Ludu",
  "license": "ISC",
  "type": "module",
  "keywords": [
    "oblio",
    "accounting",
    "mcp",
    "modelcontextprotocol",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "oblio-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.14.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && shx chmod +x dist/*.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "watch": "tsc --watch"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@obliosoftware/oblioapi": "3.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "shx": "0.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
